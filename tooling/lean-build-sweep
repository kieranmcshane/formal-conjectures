#!/bin/zsh
# lean-build-sweep — health check across all active formal-conjectures worktrees.
#                    Runs `lake build` (incremental: fast if cached) per worktree,
#                    logs status + sorry count, notifies macOS only on regression.
#
# Designed to run weekly via launchd. Complements lean-doctor (which checks
# system state every 15 min); this checks the Lean *project* state.
#
# Usage:
#   lean-build-sweep               # full sweep, log + notif on failure
#   lean-build-sweep --quiet       # idem, suppress stdout (for launchd)
#   lean-build-sweep --dry         # list worktrees + would-do, no build
#
# Behaviour:
#   - Skips prunable worktrees (e.g. /tmp/fc-implementer-*)
#   - 10 min timeout per worktree (caps stuck builds)
#   - Compares sorry count + build status to last run; notifies only on delta
#   - Logs per-run summary to ~/Library/Logs/lean-build-sweep.log
#   - State file: ~/Library/Caches/lean-build-sweep/state.json

# NB : on ne met PAS `set -u` ici — zsh + arrays + set -u génère des hangs
# silencieux dans certaines configurations.

QUIET=0
DRY=0
DEBUG=${LBS_DEBUG:-0}
(( DEBUG )) && set -x
for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=1 ;;
    --dry)   DRY=1 ;;
    -h|--help) sed -n '2,17p' "$0"; exit 0 ;;
    *) echo "argument inconnu : $arg" >&2; exit 64 ;;
  esac
done

LOG="$HOME/Library/Logs/lean-build-sweep.log"
STATE_DIR="$HOME/Library/Caches/lean-build-sweep"
STATE_PREV="$STATE_DIR/last-state.tsv"
STATE_NEW="$STATE_DIR/this-state.tsv"
mkdir -p "$STATE_DIR" "$(dirname "$LOG")"

FC_ROOT="$HOME/Documents/formal-conjectures"
[ -d "$FC_ROOT" ] || { echo "✗ $FC_ROOT introuvable" >&2; exit 1; }

# Worktrees, filtré (pas de prunable)
# Capture en variable string puis split — évite la process substitution
# `< <(...)` qui peut hang en zsh selon la config.
WORKTREES_RAW=$(cd "$FC_ROOT" && git worktree list 2>/dev/null | grep -v prunable | awk '{print $1}')
# zsh : split sur newlines en array
WORKTREES=("${(@f)WORKTREES_RAW}")
# Filtre les éléments vides (peuvent apparaître si trailing newline)
WORKTREES=("${(@)WORKTREES:#}")

# Env explicite (PAS de source ~/.zshrc — ton conda init fait des hooks
# qui ne se comportent pas dans un script non-interactif)
export LEAN_NUM_THREADS="${LEAN_NUM_THREADS:-4}"
export PATH="$HOME/.elan/bin:$HOME/.local/bin:$PATH"

START=$(date '+%Y-%m-%d %H:%M:%S')
{
  echo
  echo "═══════════════════════════════════════════════════════════"
  echo "lean-build-sweep run @ $START"
  echo "  worktrees: ${#WORKTREES[@]}"
  echo "  LEAN_NUM_THREADS=$LEAN_NUM_THREADS"
  echo "═══════════════════════════════════════════════════════════"
} >> "$LOG"

(( QUIET )) || echo "lean-build-sweep — ${#WORKTREES[@]} worktrees"

# state.tsv format: worktree<TAB>build_status<TAB>sorry_count<TAB>build_seconds
> "$STATE_NEW"

ANY_REGRESSION=0
ANY_FAIL=0

for w in "${WORKTREES[@]}"; do
  wname=$(basename "$w")
  (( QUIET )) || echo "→ $wname"
  echo "─── $wname ───" >> "$LOG"

  if (( DRY )); then
    echo "(dry run, skipped)" >> "$LOG"
    continue
  fi

  cd "$w" || { echo "  cd failed" >> "$LOG"; continue; }

  # Sorry count (TAG'd uniquement, pas les sorry dans docstrings)
  SORRIES=$(grep -rn "^[^/]*sorry" --include="*.lean" \
    --exclude-dir=.lake FormalConjectures/ 2>/dev/null \
    | grep -v "^\s*--" \
    | wc -l | tr -d ' ')

  # Build avec timeout 10 min
  BUILD_START=$(date +%s)
  BUILD_OUT=$(timeout 600 lake build 2>&1 | tail -3)
  BUILD_EXIT=$?
  BUILD_END=$(date +%s)
  BUILD_SECS=$((BUILD_END - BUILD_START))

  if (( BUILD_EXIT == 0 )); then
    STATUS="OK"
  elif (( BUILD_EXIT == 124 )); then
    STATUS="TIMEOUT"
    ANY_FAIL=1
  else
    STATUS="FAIL"
    ANY_FAIL=1
  fi

  echo "$w	$STATUS	$SORRIES	$BUILD_SECS" >> "$STATE_NEW"
  echo "  status: $STATUS  sorries: $SORRIES  time: ${BUILD_SECS}s" >> "$LOG"
  echo "  tail: $BUILD_OUT" >> "$LOG"
  (( QUIET )) || echo "  $STATUS  sorries=$SORRIES  ${BUILD_SECS}s"

  # Comparaison avec l'état précédent
  if [ -f "$STATE_PREV" ]; then
    PREV_LINE=$(grep "^$w	" "$STATE_PREV" 2>/dev/null || echo "")
    if [ -n "$PREV_LINE" ]; then
      PREV_STATUS=$(echo "$PREV_LINE" | cut -f2)
      PREV_SORRIES=$(echo "$PREV_LINE" | cut -f3)
      if [ "$STATUS" != "$PREV_STATUS" ] || [ "$SORRIES" != "$PREV_SORRIES" ]; then
        ANY_REGRESSION=1
        echo "  ⚠ delta : status $PREV_STATUS → $STATUS, sorries $PREV_SORRIES → $SORRIES" >> "$LOG"
        (( QUIET )) || echo "  ⚠ delta : $PREV_STATUS/$PREV_SORRIES → $STATUS/$SORRIES"
      fi
    fi
  fi
done

# Roule l'état (this → last)
[ -f "$STATE_NEW" ] && mv "$STATE_NEW" "$STATE_PREV"

# Notif macOS si problème
if (( ANY_FAIL || ANY_REGRESSION )); then
  if (( ANY_FAIL )); then
    TITLE="lean-build-sweep : ÉCHEC build"
    MSG="Au moins un worktree FAIL/TIMEOUT. Voir ~/Library/Logs/lean-build-sweep.log"
  else
    TITLE="lean-build-sweep : delta détecté"
    MSG="Sorry count ou status modifié. Voir le log."
  fi
  osascript -e "display notification \"$MSG\" with title \"$TITLE\"" 2>/dev/null
fi

(( QUIET )) || {
  echo
  if (( ANY_FAIL )); then
    echo "✗ build failed dans au moins un worktree"
  elif (( ANY_REGRESSION )); then
    echo "⚠ delta détecté (status/sorries)"
  else
    echo "✓ tout est cohérent"
  fi
}

(( ANY_FAIL )) && exit 2
(( ANY_REGRESSION )) && exit 1
exit 0

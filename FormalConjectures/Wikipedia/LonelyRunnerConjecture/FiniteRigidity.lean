/-- Affine reduction modulo three, with the first coordinate as slope. -/
def AffineModThree (c : BVResidueVector) : Prop :=
  (((c.c0.zeroExtend 8 = (c.c0.zeroExtend 8) * 1 % 3 ∧
        (c.c1.zeroExtend 8 = (c.c0.zeroExtend 8) * 2 % 3 ∧
          c.c2.zeroExtend 8 = (c.c0.zeroExtend 8) * 3 % 3)) ∧
      ((c.c3.zeroExtend 8 = (c.c0.zeroExtend 8) * 4 % 3 ∧
          c.c4.zeroExtend 8 = (c.c0.zeroExtend 8) * 5 % 3) ∧
        (c.c5.zeroExtend 8 = (c.c0.zeroExtend 8) * 6 % 3 ∧
          c.c6.zeroExtend 8 = (c.c0.zeroExtend 8) * 7 % 3))) ∧
    ((c.c7.zeroExtend 8 = (c.c0.zeroExtend 8) * 8 % 3 ∧
        (c.c8.zeroExtend 8 = (c.c0.zeroExtend 8) * 9 % 3 ∧
          c.c9.zeroExtend 8 = (c.c0.zeroExtend 8) * 10 % 3)) ∧
      ((c.c10.zeroExtend 8 = (c.c0.zeroExtend 8) * 11 % 3 ∧
          c.c11.zeroExtend 8 = (c.c0.zeroExtend 8) * 12 % 3) ∧
        (c.c12.zeroExtend 8 = (c.c0.zeroExtend 8) * 13 % 3 ∧
          c.c13.zeroExtend 8 = (c.c0.zeroExtend 8) * 14 % 3))))

/-- Affine reduction modulo five, with the first coordinate as slope. -/
def AffineModFive (c : BVResidueVector) : Prop :=
  (((c.c0.zeroExtend 8 = (c.c0.zeroExtend 8) * 1 % 5 ∧
        (c.c1.zeroExtend 8 = (c.c0.zeroExtend 8) * 2 % 5 ∧
          c.c2.zeroExtend 8 = (c.c0.zeroExtend 8) * 3 % 5)) ∧
      ((c.c3.zeroExtend 8 = (c.c0.zeroExtend 8) * 4 % 5 ∧
          c.c4.zeroExtend 8 = (c.c0.zeroExtend 8) * 5 % 5) ∧
        (c.c5.zeroExtend 8 = (c.c0.zeroExtend 8) * 6 % 5 ∧
          c.c6.zeroExtend 8 = (c.c0.zeroExtend 8) * 7 % 5))) ∧
    ((c.c7.zeroExtend 8 = (c.c0.zeroExtend 8) * 8 % 5 ∧
        (c.c8.zeroExtend 8 = (c.c0.zeroExtend 8) * 9 % 5 ∧
          c.c9.zeroExtend 8 = (c.c0.zeroExtend 8) * 10 % 5)) ∧
      ((c.c10.zeroExtend 8 = (c.c0.zeroExtend 8) * 11 % 5 ∧
          c.c11.zeroExtend 8 = (c.c0.zeroExtend 8) * 12 % 5) ∧
        (c.c12.zeroExtend 8 = (c.c0.zeroExtend 8) * 13 % 5 ∧
          c.c13.zeroExtend 8 = (c.c0.zeroExtend 8) * 14 % 5))))

/-- Verified finite rigidity for multiplier five and modulus three. -/
@[category test, AMS 11]
theorem blocks_robust_multiplier_five_forces_affine_mod_three
    (c : BVResidueVector) (hbound : AllLt 3 c)
    (hblocks : BlocksRobustMultiplierFive c) : AffineModThree c := by
  rcases c with ⟨c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13⟩
  simp only [AllLt, BlocksRobustMultiplierFive, AffineModThree] at *
  bv_decide

/-- Verified finite rigidity for multiplier three and modulus five. -/
@[category test, AMS 11]
theorem blocks_robust_multiplier_three_forces_affine_mod_five
    (c : BVResidueVector) (hbound : AllLt 5 c)
    (hblocks : BlocksRobustMultiplierThree c) : AffineModFive c := by
  rcases c with ⟨c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13⟩
  simp only [AllLt, BlocksRobustMultiplierThree, AffineModFive] at *
